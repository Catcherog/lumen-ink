# 默认 Provider 1: 即梦 / Seedream（火山引擎方舟）— 默认启用且为默认 Provider
# 从 https://console.volcengine.com/ark 获取 API Key
SEEDREAM_API_KEY=your_seedream_api_key_here

# 默认 Provider 2: GPT / OpenAI — 默认启用
# 从 https://platform.openai.com/api-keys 获取 API Key
OPENAI_API_KEY=your_openai_api_key_here

# ===== 以下为可选 Provider 的环境变量回退（仅当手动新增对应类型 Provider 时使用）=====

# GLM (智谱AI) — 可选，手动新增 GLM 类型 Provider 时作为 Key 回退
# 从 https://bigmodel.cn/usercenter/proj-mgmt/apikeys 获取
GLM_API_KEY=your_glm_api_key_here

# Gemini — 可选，手动新增 Gemini 类型 Provider 时作为 Key 回退
# 从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=3001

# ===== Runtime mode =====
# Default is persistent. For the public no-login demo, use all three values:
# LUMEN_RUNTIME_MODE=ephemeral-demo
# PERSISTENCE_BACKEND=disabled
# AUTH_MODE=disabled
# In deployed mode, CORS_ALLOWLIST must contain exact origins and never '*'.

# ===== D-034 Internal Security Floor =====
# 本地开发模式下以下变量可选（未设置时使用安全默认值）。
# 部署模式（VERCEL=1 或 NODE_ENV=production）下以下变量全部必填，否则启动失败。

# 登录密码（部署模式：至少 12 字符）
AUTH_PASSWORD=changeme

# JWT 签名密钥（部署模式：至少 32 字符；本地默认：lumen-ink-local-dev-secret-32chars!!）
JWT_SECRET=lumen-ink-local-dev-secret-32chars!!

# Provider API Key 加密密钥（部署模式：至少 32 字符；不得回退到 JWT_SECRET）
# 本地默认：lumen-ink-local-dev-enc-key-32chars
PROVIDER_ENCRYPTION_KEY=lumen-ink-local-dev-enc-key-32chars

# CORS 允许的源（逗号分隔；部署模式必填至少一个）
# 本地默认：http://localhost:5173,http://localhost:3001
CORS_ALLOWLIST=http://localhost:5173,http://localhost:3001

# 默认 Provider ID（可选，优先级高于 Provider 列表中的 isDefault 标记）
DEFAULT_PROVIDER_ID=
