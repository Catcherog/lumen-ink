# =============================================================================
# CloudBase NoSQL — Vercel Preview 环境变量模板
# =============================================================================
# 任务：LUMEN-CLOUDBASE-NOSQL-PREVIEW-DEPLOYMENT-READINESS-01
# 用途：仅作为 Preview 部署的配置模板。不包含任何真实凭据。
#       实际值由用户在 Vercel Dashboard → Settings → Environment Variables
#       → Preview 环境中手动配置。
# 安全：本文件可安全提交到仓库（example 后缀）；不含任何真实密钥。
# 关联：详细变量说明见 docs/lumen-v2/deploy/CLOUDBASE-NOSQL-ENV-MATRIX.md
# =============================================================================

# ===== 1. 持久化后端选择（NOSQL-R2-07）=====
# 部署模式（VERCEL=1 或 NODE_ENV=production）下必填。
# Preview 必须为 cloudbase-nosql；不允许 local（fail closed）。
PERSISTENCE_BACKEND=cloudbase-nosql

# ===== 2. CloudBase 环境与凭据 =====
# CloudBase 环境 ID（从 CloudBase 控制台获取）
# Preview 与 Production 可共享同一 envId，但通过 namespace/prefix 隔离数据。
CLOUDBASE_ENV_ID=your-cloudbase-env-id-here

# CloudBase Server API Key（JWT 格式）
# !!! 敏感凭据：禁止提交到仓库；仅在 Vercel Dashboard 配置。
# !!! Preview 必须使用 Preview-only API Key，禁止复用 Production API Key。
CLOUDBASE_API_KEY=your-cloudbase-server-api-key-here

# ===== 3. 数据命名空间隔离（NOSQL-R2-06）=====
# 所有集合名前缀。Preview 与 Production 必须使用不同值。
# Preview 推荐值：preview
# Production 推荐值：prod
CLOUDBASE_DATA_NAMESPACE=preview

# 所有 cloudPath 前缀。Preview 与 Production 必须使用不同值。
# Preview 推荐值：preview/
# Production 推荐值：prod/
CLOUDBASE_STORAGE_PREFIX=preview/

# ===== 4. 签名 URL TTL =====
# 签名 URL 有效期（秒）。Preview 推荐 900（15 分钟）。
# 范围：60 ~ 3600。过短影响使用，过长增加泄露风险。
CLOUDBASE_SIGNED_URL_TTL_SECONDS=900

# ===== 5. Preview Smoke 测试开关 =====
# 必须为 true 才允许执行 Preview smoke harness（见 RUNBOOK 第 5 步）。
# Production 环境禁止设置为 true（否则违反最小权限原则）。
ALLOW_CLOUDBASE_PREVIEW_SMOKE=true

# ===== 6. 部署模式标记 =====
# Vercel 部署时自动注入 VERCEL=1 和 NODE_ENV=production，无需手动设置。
# 以下两行仅作说明，保持注释状态：
# VERCEL=1
# NODE_ENV=production

# ===== 7. 内部安全底线（D-034，部署模式必填，否则 boot fail-fast）=====

# 登录密码（至少 12 字符）
# !!! Preview 应使用与 Production 不同的密码
AUTH_PASSWORD=your-preview-auth-password-min-12-chars

# JWT 签名密钥（至少 32 字符）
# !!! 敏感凭据：禁止提交到仓库
JWT_SECRET=your-preview-jwt-secret-min-32-chars-here

# Provider API Key 加密密钥（至少 32 字符）
# !!! 敏感凭据：禁止提交到仓库；不得与 Production 共用
PROVIDER_ENCRYPTION_KEY=your-preview-encryption-key-min-32-chars

# CORS 允许的源（逗号分隔）
# Preview 域名格式：https://<project>-git-<branch>-<owner>.vercel.app
CORS_ALLOWLIST=https://your-preview-domain.vercel.app

# ===== 8. Provider API Key（至少一个，否则无可用 Provider）=====
# !!! 敏感凭据：禁止提交到仓库
# Seedream（火山引擎方舟）— 默认 Provider
SEEDREAM_API_KEY=your-seedream-api-key-here

# ===== 9. Cron Secret（/api/worker/recover 端点鉴权）=====
# !!! Preview 通常不注册 Cron（Vercel Cron 仅在 Production Deployment 注册）
# 但 /api/worker/recover 端点仍需要此 secret 才能响应手动调用。
# !!! 敏感凭据：禁止提交到仓库
CRON_SECRET=your-preview-cron-secret-min-32-chars-here
